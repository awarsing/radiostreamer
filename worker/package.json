{
  "name": "radiostreamer-worker",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "deploy": "npm run prepare:download && wrangler deploy && wrangler deploy -c wrangler.www.toml",
    "deploy:site": "npm run prepare:download && wrangler deploy",
    "deploy:www": "wrangler deploy -c wrangler.www.toml",
    "dev": "wrangler dev",
    "prepare:download": "../.github/scripts/publish-site-download --optional",
    "typecheck": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "check": "pnpm run type-check",
    "quality": "pnpm run check"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260611.1",
    "typescript": "6.0.3",
    "wrangler": "4.100.0"
  },
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=24.11.0 <25",
    "pnpm": "11.1.2"
  }
}
